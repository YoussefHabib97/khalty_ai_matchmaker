      "chapter": 1,
      "input": "text",
      "visibility": "card",
      "question": {
        "en": "Which city?",
        "ar": "وفي أي مدينة؟"
      },
      "why": {
        "en": "Distance matters. I show only your city, never your address.",
        "ar": "المسافة مهمة. أعرض مدينتك فقط، ولا أعرض عنوانك أبدًا."
      }
    },
    {
